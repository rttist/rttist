{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES6",
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": false,
		"stripInternal": true,
		"declaration": false,
		"outDir": "dist-strict-null",
		"rootDir": "./src-strict-null",
		"baseUrl": "./src-strict-null",
		"experimentalDecorators": true,
		"plugins": [
			{
				"transform": "tst-reflect-transformer"
			}
		]
	},
	"include": [
		"src-strict-null/*.ts"
	],
	"exclude": [
		"node_modules/.pnpm/**/*",
		"dist/**/*",
		"dist-strict-null/**/*",
		"dist-mjs/**/*"
	]
}
