{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2020",
		"strict": true,
		"sourceMap": false,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "./src",
		"baseUrl": "./src",
		"plugins": [
			{
				"transform": "tst-reflect-transformer",
				"reflection": {
					"debugMode": true
				}
			}
		]
	},
	"include": [
		"./src/**/*.ts"
	],
	"exclude": [
		"node_modules/**/*",
		"dist/**/*"
	]
}
