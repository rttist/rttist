{
	"name": "swc-plugin-rttist",
	"version": "1.3.0-alpha.0",
	"description": "Rttist typegen plugin adding support for SWC",
	"main": "dist/index.js",
	"type": "commonjs",
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepare": "tsc",
		"prepublishOnly": "rimraf ./dist/ && rimraf ./tsconfig.tsbuildinfo && tsc",
		"watch": "tsc --watch"
	},
	"files": [
		"dist/**/*"
	],
	"keywords": [
		"runtime",
		"types",
		"reflection",
		"reflective",
		"reflect",
		"typescript",
		"gettype",
		"typeof",
		"typegen",
		"metadata",
		"typelib",
		"swc"
	],
	"author": "Roman Jámbor",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.0.0",
		"rimraf": "^3.0.2"
	},
	"dependencies": {
		"@rttist/core": "workspace:^",
		"@rttist/typegen": "workspace:^",
		"@swc/core": "^1.3.70",
		"woodpile": "^0.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rttist/rttist.git",
		"directory": "packages/plugins/swc"
	},
	"bugs": {
		"url": "https://github.com/rttist/rttist/issues"
	},
	"homepage": "https://rttist.org"
}
