{
	"compilerOptions": {
		"module": "commonjs",
//		"module": "ESNext",
		"target": "ES2022",
//		"moduleResolution": "NodeNext",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"strictNullChecks": true,
		"isolatedModules": true,
		"removeComments": true,
		"sourceMap": true,
		"stripInternal": true,
		"lib": []
	},
	"include": [
		"./src/**/*.ts"
	],
}
