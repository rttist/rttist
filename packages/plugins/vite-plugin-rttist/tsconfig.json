{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ES2022",
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"strictNullChecks": true,
		"isolatedModules": true,
		"removeComments": true,
		"sourceMap": true,
		"stripInternal": true,
		"lib": []
	},
	"include": ["./src/**/*.ts"]
}
