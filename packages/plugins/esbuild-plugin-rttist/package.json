{
	"name": "esbuild-plugin-rttist",
	"version": "0.19.0",
	"description": "RTTIST plugin adding support for advanced reflection features to esbuild",
	"author": "Roman Jámbor",
	"license": "MIT",
	"keywords": [
		"rttist",
		"plugin",
		"esbuild",
		"esbuild-plugin",
		"transformer",
		"reflection",
		"loader",
		"typescript",
		"runtime"
	],
	"module": "./dist/esm/index.js",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"devDependencies": {
		"tsup": "^7.2.0",
		"@types/node": "^16.0.0"
	},
	"peerDependencies": {
		"esbuild": ">=0.19.2",
		"@rttist/ts-loader-wasm": "workspace:^*",
		"@rttist/typegen": "workspace:^*"
	},
	"scripts": {
		"build": "npm run prepublishOnly",
		"build:dev": "tsup src/index.ts --format esm,cjs --legacy-output --tsconfig tsconfig.json --clean --dts --sourcemap",
		"prepublishOnly": "tsup src/index.ts --format esm,cjs --legacy-output --minify --tsconfig tsconfig.json --clean --dts"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist/index.js",
		"dist/public.typelib.js",
		"dist/esm/index.js",
		"dist/esm/package.json",
		"dist/**/*.d.ts"
	],
	"bugs": {
		"url": "https://github.com/rttist/rttist/issues"
	},
	"homepage": "https://rttist.org"
}
