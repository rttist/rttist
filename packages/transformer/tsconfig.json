{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"removeComments": true,
		"sourceMap": true,
		"stripInternal": true,
		"strictNullChecks": true,
		"strict": true,
		"rootDir": "./src",
		"baseUrl": "./src",
		"outDir": "./dist",
		"composite": true,
		"esModuleInterop": true
	},
	"include": [
		"./src/**/*.ts"
	],
	"exclude": [
		"node_modules/**/*",
		"dist/**/*"
	]
}
