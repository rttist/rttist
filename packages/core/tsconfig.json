{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"sourceMap": false,
		"strict": true,
		"stripInternal": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "./src",
		"baseUrl": "./src",
		"composite": true
	},
	"include": [
		"./src/**/*.ts"
	],
	"exclude": [
		"node_modules/**/*",
		"dist/**/*"
	]
}
