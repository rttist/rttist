{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES6",
		"sourceMap": false,
		"strict": true,
		"stripInternal": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "./src",
		"typeRoots": [
			"node_modules"
		]
	},
	"include": [
		"./src/**/*.ts"
	],
	"exclude": [
		"./src/helpers.ts",
		"./src/builders/**/*.ts",
		"./src/type-builder/**/*.ts",
	]
}
