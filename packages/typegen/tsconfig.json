{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "es2022",
		"moduleResolution": "nodenext",
		"sourceMap": true,
		"declaration": true,
		"stripInternal": true,
		"strict": true,
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": ".",
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"jsxFactory": "React.createElement",
		"jsxFragmentFactory": "React.Fragment",
		"lib": ["es2022"],
		"types": []
	},
	"files": [
		"src/main.ts",
		"src/declarations/globals.ts",
		"src/bin.ts",
		"src/worker.ts",
		"src/lib/watcher.ts",
		"src/lib/debugger.ts"
	]
	//	"include": [
	//		"src/**/*.ts"
	//	]
}
