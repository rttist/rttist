{
	"name": "@rttist/typegen",
	"version": "0.1.0",
	"description": "Type generator for RTTIST",
	"bin": {
		"typegen": "dist/bin.js"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepare": "tsc",
		"prepublishOnly": "rimraf ./dist/ && rimraf ./tsconfig.tsbuildinfo && tsc"
