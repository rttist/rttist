{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2020",
		"lib": ["ES2020", "DOM"],
		"sourceMap": false,
		"strict": true,
		"stripInternal": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": "src",
		"composite": true,
		"isolatedModules": true,
		"types": []
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules/**/*",
		"dist/**/*",
		"src/metadata.typelib.ts"
	]
}
