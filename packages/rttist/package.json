{
	"name": "rttist",
	"version": "1.0.0-rc.1",
	"description": "Abstract declarations for TypeScript runtime reflection",
	"main": "./dist/index.js",
	"module": "./dist/esm/index.js",
	"type": "commonjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./dist/public.typelib": "./dist/public.typelib.js",
		"./dist/public.typelib.js": "./dist/public.typelib.js",
		"./dist/public.typelib.ts": "./dist/public.typelib.js",
		"./typelib": "./assets/virtual-typelib.d.ts",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"build": "npm run prepublishOnly",
		"prepublishOnly": "npm run bundle && npm run postbuild",
		"bundle": "tsup src/index.ts --format esm,cjs --legacy-output --minify --tsconfig tsconfig.json --clean",
		"typegen": "node ../typegen/dist/bin.js generate -f",
		"dev": "tsup src/index.ts --format esm,cjs --legacy-output --minify --tsconfig tsconfig.json --sourcemap --watch",
		"generate:types": "tsc --emitDeclarationOnly --outDir dist",
		"postbuild": "node ./post-build.js",
		"start": "tsc -w"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist/index.js",
		"dist/esm/index.js",
		"dist/esm/package.json",
		"dist/**/*.d.ts",
		"dist/assets/*.d.ts"
	],
	"keywords": [
		"abstract",
		"declaration",
		"type",
		"types",
		"runtime",
		"reflection",
		"reflective",
		"reflect",
		"typescript",
		"gettype",
		"typeof",
		"system",
		"core"
	],
	"author": "Roman Jámbor",
	"license": "MIT",
	"dependencies": {
		"@rttist/core": "workspace:^",
		"esbuild": "^0.18.11",
		"tsup": "^8.5.0"
	},
	"devDependencies": {
		"cpy-cli": "^5.0.0",
		"rimraf": "^3.0.2",
		"typescript": "5.8.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rttist/rttist.git",
		"directory": "packages/rttist"
	},
	"bugs": {
		"url": "https://github.com/rttist/rttist/issues"
	},
	"homepage": "https://rttist.org"
}
