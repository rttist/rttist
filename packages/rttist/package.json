{
	"name": "rttist",
	"version": "1.0.0-beta.1",
	"description": "Abstract declarations for TypeScript runtime reflection",
	"main": "./dist/index.js",
	"module": "./dist/esm/index.js",
	"type": "commonjs",
	"types": "dist/index.d.ts",
	"exports": {
		"default": "./dist/index.js",
		"require": "./dist/index.js",
		"import": "./dist/esm/index.js"
	},
	"engines": {
		"node": ">=16.0.0"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepare": "npm run build && npm run generate:esmpackage && npm run generate:types",
		"build": "tsup src/index.ts --format esm,cjs --legacy-output --minify --tsconfig tsconfig.json --clean --keep-names",
		"generate:types": "tsc --emitDeclarationOnly --outDir dist",
		"generate:esmpackage": "node ./create-esm-package-json.js",
		"prepublishOnly": "tsc --emitDeclarationOnly --outDir dist"
	},
	"files": [
		"LICENSE",
		"README.md",
		"dist/**/*.js",
		"dist/**/*.d.ts"
	],
	"keywords": [
		"abstract",
		"declaration",
		"type",
		"types",
		"runtime",
		"reflection",
		"reflective",
		"reflect",
		"typescript",
		"gettype",
		"typeof",
		"system",
		"core"
	],
	"author": "Roman Jámbor",
	"license": "MIT",
	"dependencies": {
		"@rttist/core": "workspace:^",
		"esbuild": "^0.18.11",
		"tsup": "^7.2.0"
	},
	"devDependencies": {
		"rimraf": "^3.0.2",
		"typescript": "4.8.x"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rttist/rttist.git",
		"directory": "packages/rttist"
	},
	"bugs": {
		"url": "https://github.com/rttist/rttist/issues"
	},
	"homepage": "https://rttist.org"
}
