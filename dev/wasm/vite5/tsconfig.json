{
	"compilerOptions": {
		"strict": true,
		"target": "ESNext",
		"module": "ESNext",
		//		"rootDir": "src",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"resolveJsonModule": true,
		"types": ["vite/client"],
		"noEmit": true,
		"isolatedModules": true
	},
	"include": ["src/**/*"],
	"references": [
		{
			"path": "./tsconfig.node.json"
		}
	]
}
