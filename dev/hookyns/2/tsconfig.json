{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "node",
		"target": "ESNext",
		"lib": ["ESNext"],
		"removeComments": true,
//		"declaration": false,
		"noImplicitAny": false,
		"sourceMap": true,
		"experimentalDecorators": true,
		"rootDir": ".",
		"outDir": "dist",
		"plugins": [
//			{
//				"transform": "tst-reflect-transformer"
//			}
		],
		"types": []
	},
	"files": ["index.ts"],
	"include": [
		"framework",
		"controllers"
	],
	"exclude": [
		"node_modules/**/*",
		"node_modules"
	]
}