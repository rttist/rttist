{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022"],
		"removeComments": true,
//		"declaration": false,
		"noImplicitAny": false,
		"sourceMap": true,
		"experimentalDecorators": true,
		"rootDir": "src",
		"outDir": "dist",
		"plugins": [
//			{
//				"transform": "tst-reflect-transformer"
//			}
		],
		"types": ["node"]
	},
	"files": ["src/index.ts"],
//	"include": [
//		"framework",
//		"controllers"
//	],
	"exclude": [
		"node_modules/**/*",
		"node_modules"
	]
}