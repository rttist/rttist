{
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ESNext",
//		"module": "CommonJS",
//		"target": "ESNext",
		"removeComments": false,
		"declaration": false,
		"sourceMap": true,
		"experimentalDecorators": true,
		"rootDir": ".",
		"outDir": "dist",
		"plugins": [
			{
				"transform": "tst-reflect-transformer"
			}
		]
	},
	"files": [
		"index.ts"
	],
	"include": [
		"declarations.d.ts"
	],
	"exclude": [
		"dist"
	]
}