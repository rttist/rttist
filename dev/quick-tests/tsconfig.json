{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "ESNext",
		"esModuleInterop": true,
		"removeComments": false,
		"declaration": true,
		"sourceMap": true,
		"experimentalDecorators": true,
		"rootDir": "..",
		//		"typeRoots": [
		//			"../../node_modules/@types",
		//			"../../node_modules/@rtti/abstract/node_modules/@types"
		//		],
		"plugins": [
			{
				"transform": "tst-reflect-transformer"
			}
		]
	},
	"include": [
		"**/*.ts"
	],
	"reflection": {
		"metadata": {
			"type": "typelib"
		},
		"debugMode": true
	}
}