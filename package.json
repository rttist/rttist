{
	"private": true,
	"name": "rttist",
	"license": "MIT",
	"workspaces": [
		"packages/core",
		"packages/abstract",
		"packages/transformer",
		"dev-packages/pkg1",
		"dev-packages/pkg2-mjs",
		"dev/hookyns/1",
		"tests"
	],
	"scripts": {
		"test": "rimraf ./tests/dist/ && ttsc -p ./tests/tsconfig.json && ttsc -p ./tests/tsconfig-strict-null.json && ttsc -p ./tests/tsconfig-mjs.json && jest",
		"test:base": "rimraf ./tests/dist/ && ttsc -p ./tests/tsconfig.json && jest",
		"test:coverage": "npm test -- --coverage",
		"test:badges": "npm run test:coverage && make-coverage-badge -- --output-path ./docs/_images/coverage-badge.svg"
	},
	"engines": {
		"npm": ">=7.10.0",
		"node": ">=16.0.0"
	},
	"devDependencies": {
		"@types/jest": "^27.4.0",
		"@types/node": "^18.0.0",
		"all-contributors-cli": "^6.20.0",
		"jest": "^27.5.1",
		"make-coverage-badge": "^1.2.0",
		"prettier": "^3.0.0",
		"rimraf": "^3.0.2",
		"ts-node": "^10.4.0",
		"ttypescript": "1.x",
		"typescript": "5.1.6"
	},
	"dependencies": {
		"@swc/core": "^1.3.70"
	}
}
